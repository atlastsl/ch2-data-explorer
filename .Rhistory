source("./models.R")
fit1 <- felp_model(
dataset = SLB_final_wprc_db |> filter(!is.na(spt_pnlt_rwrd_num)),
Y = c("ret"),
X = c(
"spt_pnlt_rwrd_num",
"post_obs_date_dum",
"spt_pnlt_rwrd_num:post_obs_date_dum"
),
fe = c("obs_date"),
cl = c("cusip_id")
)
summary(fit1)
