pivot_longer(
cols = -Dates,
names_to = "cusip_id",
values_to = "price"
) |>
rename(date = Dates) |>
mutate(
date = as.POSIXct(date, tz = "UTC", format = "%m/%d/%Y"),
price = as.numeric(price)
)
