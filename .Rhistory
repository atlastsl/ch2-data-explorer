library(ggplot2)
y_axis_bottom <- 0
y_axis_top <- 8
# Points voulus
B <- 5.0
C <- 8.2
y_vertex <- 7.6
# Parabole
a <- (y_vertex - y_axis_bottom) / (C - B)^2
f <- function(x) -a * (x - B)^2 + y_vertex
# Droite
m <- -0.55
b <- 6.5
g <- function(x) m * x + b
# Intersection A
h <- function(x) f(x) - g(x)
A <- uniroot(h, lower = 2.0, upper = B)$root
# Données
x_par <- seq(2.7, C, length.out = 400)
parab_df <- data.frame(
x = x_par,
