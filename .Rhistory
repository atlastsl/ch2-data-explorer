)
#| label: fig-h6-rlw
#| fig-cap: "Lien Localisation - Liquidité en immobilier réel"
#| fig-subcap:
#|   - "Régime normal"
#|   - "Régime d'attention globale forte"
#|   - "Régime spéculatif"
#| layout-ncol: 3
#par(mfrow=c(1, 3))
x <- seq(0, 1, by=0.01)
plot(x, y=0.7-0.6*x, xaxt="n", yaxt='s', type="l", ylim=c(0,1), xlab="Localisation", ylab="Liquidity", main=NULL)
plot(x, y=0.8-0.5*x, xaxt="n", yaxt='s', type="l", ylim=c(0,1), xlab="Localisation", ylab="Liquidity", main=NULL)
plot(x, y=1-0.3*x, xaxt="n", yaxt='s', type="l", ylim=c(0,1), xlab="Localisation", ylab="Liquidity", main=NULL)
